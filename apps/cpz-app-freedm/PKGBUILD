# Maintainer: CPZ <cpz-ui@jmas.github.io>
#
# FreeDM is the Freedoom deathmatch WAD for Doom II-compatible engines.

pkgname=cpz-app-freedm
pkgver=1.0.0
pkgrel=1
pkgdesc="FreeDM for CPZ Games"
arch=('any')
url="https://freedoom.github.io/"
license=('BSD-3-Clause')
depends=('doomretro')
options=('!strip')
source=('https://github.com/freedoom/freedoom/releases/download/v0.13.0/freedm-0.13.0.zip')
sha256sums=('b420f13508ef745d7b38e83d15e55e0fc0b09d9a503c96741cddd9773d43f7c9')

package() {
    install -Dm644 "$srcdir/freedm-0.13.0/freedm.wad" \
        "$pkgdir/usr/share/cpz/freedoom/freedm.wad"
    install -Dm644 "$srcdir/freedm-0.13.0/COPYING.txt" \
        "$pkgdir/usr/share/licenses/$pkgname/COPYING.txt"
    install -Dm644 "$startdir/cpz-freedm.desktop" \
        "$pkgdir/usr/share/applications/cpz-freedm.desktop"
}
