# Maintainer: CPZ <cpz-ui@jmas.github.io>
#
# Bronze is Emily Short's Z-code interactive fiction. It is a Z-machine Blorb,
# so the same Frotz interpreter used for The Dreamhold plays it.

pkgname=cpz-app-bronze
pkgver=1.0.0
pkgrel=1
pkgdesc="Bronze for CPZ Games"
arch=('any')
url="https://ifdb.org/viewgame?id=9p8kh3im2j9h2881"
license=('custom')
depends=('frotz-ncurses')
options=('!strip')
source=('https://ifarchive.org/if-archive/games/zcode/Bronze.zblorb')
sha256sums=('173f8aa40366c809909441cd0296186f13f8c33e5c2323d3ba75b35cda21ffe5')

package() {
    install -Dm644 "$srcdir/Bronze.zblorb" \
        "$pkgdir/usr/share/cpz/if/bronze.zblorb"
    install -Dm644 "$startdir/cpz-bronze.desktop" \
        "$pkgdir/usr/share/applications/cpz-bronze.desktop"
    install -dm755 "$pkgdir/usr/share/doc/$pkgname"
    cat > "$pkgdir/usr/share/doc/$pkgname/NOTICE" <<'EOF'
Bronze
Copyright 2006 Emily Short.
Freeware interactive fiction, distributed as the demonstration game for
Inform 7. Story file from the IF Archive:
https://ifarchive.org/if-archive/games/zcode/Bronze.zblorb
EOF
}
