# Maintainer: CPZ <cpz-ui@jmas.github.io>
#
# Freedoom Phase 2 is the Doom II-compatible free game. It is a separate
# package so Applications can install and remove it on its own.

pkgname=cpz-app-freedoom-phase2
pkgver=1.0.0
pkgrel=1
pkgdesc="Freedoom: Phase 2 for CPZ Games"
arch=('any')
url="https://freedoom.github.io/"
license=('BSD-3-Clause')
depends=('doomretro')
options=('!strip')
source=('https://github.com/freedoom/freedoom/releases/download/v0.13.0/freedoom-0.13.0.zip')
sha256sums=('3f9b264f3e3ce503b4fb7f6bdcb1f419d93c7b546f4df3e874dd878db9688f59')

package() {
    install -Dm644 "$srcdir/freedoom-0.13.0/freedoom2.wad" \
        "$pkgdir/usr/share/cpz/freedoom/freedoom2.wad"
    install -Dm644 "$srcdir/freedoom-0.13.0/COPYING.txt" \
        "$pkgdir/usr/share/licenses/$pkgname/COPYING.txt"
    install -Dm644 "$startdir/cpz-freedoom-phase2.desktop" \
        "$pkgdir/usr/share/applications/cpz-freedoom-phase2.desktop"
}
