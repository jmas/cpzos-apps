# Maintainer: CPZ <cpz-ui@jmas.github.io>
#
# Freedoom Phase 1 is the Doom-compatible free game. The engine is Doom Retro;
# the game name in the desktop entry is Freedoom, because that is what starts.

pkgname=cpz-app-freedoom-phase1
pkgver=1.1.0
pkgrel=1
pkgdesc="Freedoom: Phase 1 for CPZ Games"
arch=('any')
url="https://freedoom.github.io/"
license=('BSD-3-Clause')
depends=('doomretro')
options=('!strip')
source=('https://github.com/freedoom/freedoom/releases/download/v0.13.0/freedoom-0.13.0.zip')
sha256sums=('3f9b264f3e3ce503b4fb7f6bdcb1f419d93c7b546f4df3e874dd878db9688f59')
# The old package was named after the franchise, but it starts Freedoom.
# Replace it so an existing device loses cpz-doom.desktop instead of keeping a
# second, misnamed entry.
replaces=('cpz-app-doom')
conflicts=('cpz-app-doom')

package() {
    install -Dm644 "$srcdir/freedoom-0.13.0/freedoom1.wad" \
        "$pkgdir/usr/share/cpz/freedoom/freedoom1.wad"
    install -Dm644 "$srcdir/freedoom-0.13.0/COPYING.txt" \
        "$pkgdir/usr/share/licenses/$pkgname/COPYING.txt"
    install -Dm644 "$startdir/cpz-freedoom-phase1.desktop" \
        "$pkgdir/usr/share/applications/cpz-freedoom-phase1.desktop"
}
