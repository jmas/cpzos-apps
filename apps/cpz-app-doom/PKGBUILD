# Maintainer: CPZ <cpz-ui@jmas.github.io>

pkgname=cpz-app-doom
pkgver=1.0.0
pkgrel=1
pkgdesc="Doom with the free Freedoom data for CPZ Games"
arch=('any')
url="https://freedoom.github.io/"
license=('BSD-3-Clause')
depends=('doomretro')
options=('!strip')
source=('https://github.com/freedoom/freedoom/releases/download/v0.13.0/freedoom-0.13.0.zip')
sha256sums=('3f9b264f3e3ce503b4fb7f6bdcb1f419d93c7b546f4df3e874dd878db9688f59')

package() {
    install -Dm644 "$srcdir/freedoom-0.13.0/freedoom1.wad" \
        "$pkgdir/usr/share/cpz/doom/freedoom1.wad"
    install -Dm644 "$startdir/cpz-doom.desktop" \
        "$pkgdir/usr/share/applications/cpz-doom.desktop"
}
