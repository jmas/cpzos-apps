pkgname=cpz-app-nbsdgames
pkgver=1.0.0
pkgrel=1
pkgdesc="NBSDGAMES! collection for CPZ Games"
arch=('any')
url="https://github.com/abakh/nbsdgames"
license=('LicenseRef-custom')
depends=('nbsdgames')
options=('!strip')
