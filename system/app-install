#!/bin/sh
# CPZ package helper. The only privileged entry point for Applications.
#
#   app-install refresh-catalog [--force]
#   app-install update-system
#   app-install update-all
#   app-install install <package>
#   app-install remove  <package>
#   app-install power reboot|off
#   app-install wifi on|off|status
#   app-install bt   on|off|status
#   app-install display apply
#
# Installed by cpz-system-apps; sudoers allows user cpz to run this file only.
set -eu
export LC_ALL=C
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
umask 022

die() {
    printf 'app-install: %s\n' "$*" >&2
    exit 1
}
log() {
    command -v logger >/dev/null 2>&1 && logger -t cpz-app-install -- "$*" || true
}

# Esc in Applications or Settings cancels the helper. Pacman is a child
# process; forward the signal and wait so its lock is released before we exit.
# A transaction interrupted mid-flight may still need a retry.
pacman_pid=
on_term() {
    trap - TERM INT
    if [ -n "$pacman_pid" ]; then
        kill -TERM "$pacman_pid" 2>/dev/null || true
        wait "$pacman_pid" 2>/dev/null || true
    fi
    exit 130
}
trap on_term TERM INT

run_pacman() {
    pacman "$@" &
    pacman_pid=$!
    if wait "$pacman_pid"; then
        rc=0
    else
        rc=$?
    fi
    pacman_pid=
    return "$rc"
}

[ "$(id -u)" -eq 0 ] || die "must run as root"
[ "$#" -ge 1 ] || die "usage: app-install refresh-catalog [--force]|update-system|update-all|install <pkg>|remove <pkg>|power reboot|off|wifi on|off|status|bt on|off|status|display apply"

case "$1" in
    refresh-catalog)
        [ "$#" -le 2 ] || die "refresh-catalog takes only --force"
        if [ "$#" -eq 2 ] && [ "$2" != "--force" ]; then
            die "refresh-catalog: unknown option: $2"
        fi
        ;;
    update-system)
        [ "$#" -eq 1 ] || die "update-system takes no arguments"
        ;;
    update-all)
        [ "$#" -eq 1 ] || die "update-all takes no arguments"
        ;;
    install|remove)
        [ "$#" -eq 2 ] || die "$1 takes exactly one package"
        printf '%s' "$2" | grep -Eq '^[a-z0-9][a-z0-9@._+-]*$' ||
            die "invalid package name: $2"
        ;;
    power)
        [ "$#" -eq 2 ] || die "power takes reboot|off"
        case "$2" in
            reboot|off) ;;
            *) die "invalid power action: $2" ;;
        esac
        ;;
    wifi|bt)
        [ "$#" -eq 2 ] || die "$1 takes on|off|status"
        case "$2" in
            on|off|status) ;;
            *) die "invalid $1 action: $2" ;;
        esac
        ;;
    display)
        [ "$#" -eq 2 ] || die "display takes apply"
        [ "$2" = "apply" ] || die "invalid display action: $2"
        ;;
    *)
        die "unknown action: $1"
        ;;
esac

protected() {
    pkg=$1
    case "$pkg" in
        cpz-system-apps|cpz-apps-catalog|cpz-ui)
            return 0
            ;;
    esac
    [ -f /usr/share/cpz/protected-packages ] || return 1
    grep -Fxq -- "$pkg" /usr/share/cpz/protected-packages
}

refresh_catalog() {
    force=${1:-}
    mkdir -p /var/lib/cpz
    marker=/var/lib/cpz/refresh
    if [ "$force" != "--force" ] && [ -f "$marker" ]; then
        last=$(stat -c %Y "$marker" 2>/dev/null || printf 0)
        now=$(date +%s)
        if [ $((now - last)) -lt 600 ]; then
            log "refresh skipped: rate limited"
            exit 0
        fi
    fi
    : > "$marker"

    # Sync databases, then install the data-only catalog package. The catalog
    # has no dependencies and installs no code, so this is the single allowed
    # -S without -u; every real install below upgrades first.
    if ! run_pacman -Sy --noconfirm; then
        rm -f "$marker"
        exit 1
    fi
    log "refreshing cpz-apps-catalog"
    if ! run_pacman -S --needed --noconfirm cpz-apps-catalog; then
        rm -f "$marker"
        exit 1
    fi
}

full_upgrade() {
    # The boot kernel and firmware are generated into the FAT partition by the
    # image build. Updating them inside a running rootfs would install modules
    # without the matching boot files, so an on-device update keeps the pinned
    # kernel and bootloader. A new kernel comes with a new image.
    run_pacman -Syu --noconfirm --ignore linux-rpi --ignore raspberrypi-bootloader
}

install_app() {
    pkg=$1
    if protected "$pkg"; then
        printf 'app-install: protected package: %s\n' "$pkg" >&2
        exit 5
    fi

    log "install $pkg: full system upgrade first"
    full_upgrade

    if ! pacman -Si -- "$pkg" 2>/dev/null | grep -Eq '^Repository[[:space:]]*:[[:space:]]*cpz-apps$'; then
        printf 'app-install: not an app from [cpz-apps]: %s\n' "$pkg" >&2
        exit 4
    fi
    run_pacman -S --needed --noconfirm -- "$pkg"
}

remove_app() {
    pkg=$1
    if protected "$pkg"; then
        printf 'app-install: protected package: %s\n' "$pkg" >&2
        exit 5
    fi
    if ! pacman -Qq -- "$pkg" >/dev/null 2>&1; then
        printf 'app-install: not installed: %s\n' "$pkg" >&2
        exit 4
    fi
    log "remove $pkg"
    run_pacman -Rns --noconfirm -- "$pkg"
}

case "$1" in
    refresh-catalog)
        refresh_catalog "${2:-}"
        ;;
    update-system)
        log "system update"
        full_upgrade
        ;;
    update-all)
        log "system and catalog update"
        full_upgrade
        refresh_catalog --force
        ;;
    install)
        install_app "$2"
        ;;
    remove)
        remove_app "$2"
        ;;
    power)
        log "power $2"
        case "$2" in
            reboot) systemctl reboot ;;
            off) systemctl poweroff ;;
        esac
        ;;
    display)
        log "display $2"
        systemctl restart cpz-ui@tty1.service
        ;;
    wifi|bt)
        unit=iwd
        [ "$1" = "bt" ] && unit=bluetooth
        case "$2" in
            on)
                log "$1 on"
                systemctl enable --now "$unit"
                ;;
            off)
                log "$1 off"
                systemctl disable --now "$unit"
                ;;
            status)
                if systemctl is-active --quiet "$unit"; then
                    printf 'on\n'
                else
                    printf 'off\n'
                fi
                ;;
        esac
        ;;
esac
