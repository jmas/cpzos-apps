#!/bin/sh
# Unmount one USB filesystem mounted by cpz-automount. The caller is the
# unprivileged UI; sudoers allows only this file. The device is validated here
# and again by cpz-automount before it touches the mount table.
set -eu
[ "$#" -eq 1 ] || exit 2
case "$1" in
    /dev/?*) ;;
    *) exit 2 ;;
esac
case "$1" in
    *..* | */*/*) exit 2 ;;
esac
exec /usr/local/bin/cpz-automount umount "$1"
