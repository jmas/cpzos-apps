#!/bin/sh
# Unmount one filesystem mounted by cpz-automount. The caller is the
# unprivileged UI; sudoers allows only this file. Accept either the device
# (/dev/sda1) or the mounted directory (/media/<label>); the device is
# validated here and again by cpz-automount before the mount table is touched.
set -eu

die() {
    printf 'media-umount: %s\n' "$*" >&2
    command -v logger >/dev/null 2>&1 && logger -t cpz-media-umount -- "$*" || true
    exit 2
}

[ "$#" -eq 1 ] || die "usage: media-umount <device|mountpoint>"
case "$1" in
    /dev/?*)
        dev=$1
        ;;
    /*)
        dev=$(findmnt -n -o SOURCE --target "$1" 2>/dev/null | head -n 1) ||
            die "not mounted: $1"
        dev=${dev%%\[*}
        [ -n "$dev" ] || die "not mounted: $1"
        ;;
    *)
        die "invalid path: $1"
        ;;
esac
# Resolve by-id/by-uuid symlinks to the kernel name the automount helper
# recorded. The node can be gone after a yank; keep the original then.
if [ -e "$dev" ]; then
    resolved=$(readlink -f -- "$dev" 2>/dev/null) || resolved=
    [ -n "$resolved" ] && dev=$resolved
fi
case "$dev" in
    /dev/*) ;;
    *) die "not a device: $dev" ;;
esac
# Exactly one component under /dev. The old */*/* pattern also matched
# "/dev/sda1" (it has two slashes), so every valid unmount was rejected.
rest=${dev#/dev/}
case "$rest" in
    '' | . | .. | */* | *..*) die "invalid device: $dev" ;;
esac
# Test hook: stop after validation so CI can check the accepted device without
# touching the mount table. sudoers does not allow passing this environment.
if [ "${CPZ_MEDIA_UMOUNT_TEST:-}" = "1" ]; then
    printf '%s\n' "$dev"
    exit 0
fi
[ -x /usr/local/bin/cpz-automount ] || die "cpz-automount is not installed"
exec /usr/local/bin/cpz-automount umount "$dev"
