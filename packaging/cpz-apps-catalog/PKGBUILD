# Maintainer: CPZ <cpz-ui@jmas.github.io>
#
# Data-only catalog package. It must never gain a dependency or an executable:
# the background refresh installs it with -S without -u (see app-install).

pkgname=cpz-apps-catalog
pkgver=${CATALOG_VERSION:-0.1.0}
pkgrel=1
pkgdesc="CPZ application catalog for Applications"
arch=('any')
url="https://github.com/jmas/cpzos-apps"
license=('CC0-1.0')
depends=()
options=('!strip')
source=()
sha256sums=()

package() {
    install -Dm644 "$startdir/apps.json" \
        "$pkgdir/usr/share/cpz/catalog/apps.json"
}
